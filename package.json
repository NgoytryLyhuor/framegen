{
  "name": "framegen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-only AI video frame interpolation (RIFE via framegen + WebGPU). No uploads, everything runs in your browser.",
  "scripts": {
    "predev": "node scripts/copy-weights.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-weights.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "framegen": "^1.4.0",
    "mp4-muxer": "^2.1.0",
    "mp4box": "^0.5.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@webgpu/types": "^0.1.72",
    "typescript": "~5.6.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
